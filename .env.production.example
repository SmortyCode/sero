# SERO — Produktionsvorlage (KEINE Secrets hier eintragen)
# Kopieren nach .env und Werte setzen. dry_run bleibt DB-gesteuert (kv).

# --- Kern ---
SERO_ENV=production
# PUBLIC_BASE_URL=https://dein-domain.tld
# SERO_TRUST_PROXY=1

# --- Auth / Mail ---
# RESEND_API_KEY=
# ADMIN_EMAIL=du@example.org
# SERO_ADMIN_EMAIL=          # OTP-Skip nur Backend; Default im Code, nicht hier.

# --- eBay ---
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RUNAME=
# EBAY_ENV=production

# --- Stripe (Abo) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_RESELLER=
# STRIPE_PRICE_SHOP=

# --- Preisquellen (Lizenz — nur mit Freigabe) ---
# SERO_QUELLE_130POINT=1
# SERO_QUELLE_PRICECHARTING=1

# --- ADR-001 Skalierung (noch NICHT aktiv — Schwelle ~20 Nutzer) ---
# SERO_STORE_BACKEND=sqlite
# SERO_PHOTO_BACKEND=fs
# SERO_QUEUE_BACKEND=memory
# # DATABASE_URL=postgresql://...
# # SERO_S3_BUCKET=
# # SERO_S3_ENDPOINT=

# --- Social Login (siehe docs/AUTH_SETUP.md) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LISTO_BOT_USERNAME=EBAYSERO_bot
# SERO_TELEGRAM_LOGIN=1
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SERO_PHONE_AUTH=0
