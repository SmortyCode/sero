# SERO — Konfigurationsvorlage (Audit P0.1). Kopieren nach .env und ausfüllen.
# NIEMALS echte Schlüssel in diese Datei oder ins Repo schreiben.

# ── Pflicht für den Kernbetrieb ──────────────────────────────────────────────
ANTHROPIC_API_KEY=            # console.anthropic.com — Bilderkennung/Analyse
CLAUDE_MODEL=claude-sonnet-5
TELEGRAM_BOT_TOKEN=           # @BotFather; der Bot teilt sich das Backend mit der App
EBAY_CLIENT_ID=               # developer.ebay.com (Production Keyset)
EBAY_CLIENT_SECRET=

# ── eBay-Verkaufsrichtlinien (Fallback; je Nutzer kommen sie aus der DB) ─────
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_FULFILLMENT_POLICY_18_ID=   # Versand mit DHL-Alterssichtprüfung (USK-18-Titel)

# ── Umgebung ─────────────────────────────────────────────────────────────────
APP_ENV=dev                   # "production" schaltet fail-closed:
                              #   - Checkout ohne Stripe-Key wird abgelehnt
                              #   - Session-Cookie bekommt das Secure-Flag
                              #   - PUBLIC_BASE_URL wird Pflicht
PUBLIC_BASE_URL=              # z.B. https://sero.app — Basis für Login-Mail/Stripe/OAuth-Links
DRY_RUN=true                  # true = publishOffer wird NIE aufgerufen (Testbetrieb)
# SERO_DEV_CODES=1            # NUR lokal: Login-Codes in der API-Antwort. NIE im Deploy setzen.

# ── Pfade (Default: Projektordner bzw. ~/sero-app) ───────────────────────────
# SERO_DB=/pfad/zu/data.db
# SERO_APP_DIR=/pfad/zu/sero-app/web
# SERO_COL_DIR=/pfad/zu/collection_photos
# LISTO_SITE_DIR=/pfad/zur/website

# ── Bezahlung + E-Mail (erst fürs Deploy nötig) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER= / STRIPE_PRICE_RESELLER= / STRIPE_PRICE_SHOP=
RESEND_API_KEY=
EMAIL_FROM=SERO <onboarding@resend.dev>
ADMIN_EMAIL=

# ── Anmeldung über Drittanbieter (optional) ──────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Preisquellen (optional; Rechtslage siehe docs/IMPLEMENTATION_STATUS.md) ──
PRICECHARTING_TOKEN=
# SERO_EBAY_INSIGHTS=1        # nur falls eBay Marketplace Insights je bewilligt wird

# ── Alt/Telegram ─────────────────────────────────────────────────────────────
LISTO_BOT_USERNAME=EBAYSERO_bot
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
